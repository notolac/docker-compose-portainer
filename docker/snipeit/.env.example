# Snipe-IT environment template — copy to .env and fill in values
# Generate APP_KEY: docker compose run --rm app php artisan key:generate --show

APP_VERSION=v8.4.0
APP_PORT=8080
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGEME
APP_URL=https://snipeit.example.com
APP_TIMEZONE=UTC
APP_LOCALE=en-US
MAX_RESULTS=500

DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=CHANGEME
MYSQL_ROOT_PASSWORD=CHANGEME

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDR=snipeit@example.com
MAIL_FROM_NAME=Snipe-IT

APP_TRUSTED_PROXIES=172.16.0.0/12,10.0.0.0/8

SNIPEIT_STORAGE_PATH=/opt/snipeit
SNIPEIT_DB_PATH=/opt/snipeit_db
