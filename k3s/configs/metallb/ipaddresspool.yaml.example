# MetalLB address pool — EXAMPLE. Copy, rename, and set a free range of YOUR LAN.
# The range must be outside your DHCP pool and not used by anything else.
# Docs: https://metallb.universe.tf/configuration/#address-pools
apiVersion: metallb.io/v1beta1
kind: IPAddressPool
metadata:
  name: main
  namespace: metallb-system
spec:
  addresses:
    - 192.168.1.240-192.168.1.249
---
apiVersion: metallb.io/v1beta1
kind: L2Advertisement
metadata:
  name: main
  namespace: metallb-system
