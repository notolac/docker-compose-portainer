# Cloudflare DNS token for Traefik ACME DNS-01 — TEMPLATE, never commit real values.
# Create it imperatively instead (same result, nothing on disk):
#   kubectl -n traefik create secret generic traefik-cloudflare-dns \
#     --from-literal=token='<CLOUDFLARE_DNS_API_TOKEN>'
# Referenced by traefik-values.yaml (env CF_DNS_API_TOKEN valueFrom secretKeyRef).
apiVersion: v1
kind: Secret
metadata:
  name: traefik-cloudflare-dns
  namespace: traefik
type: Opaque
stringData:
  token: "<CLOUDFLARE_DNS_API_TOKEN>"
