# Authentik forwardAuth as a Traefik Middleware CRD — TEMPLATE.
# Alternative to the file-provider `authentikForwardAuth@file` in middlewares.yaml.
# Use this when you prefer the dual model via standard Ingress annotations:
#   traefik.ingress.kubernetes.io/router.middlewares: traefik-authentik-forwardauth@kubernetescrd
# Set YOUR Authentik host first, then apply:
#   kubectl apply -f middleware-authentik.yaml
# (Rename the file to drop the `.example` suffix after setting your host.)
apiVersion: traefik.io/v1alpha1
kind: Middleware
metadata:
  name: authentik-forwardauth
  namespace: traefik
spec:
  forwardAuth:
    address: https://auth.example.com/outpost.goauthentik.io/auth/traefik
    trustForwardHeader: true
    authResponseHeaders:
      - X-authentik-username
      - X-authentik-groups
      - X-authentik-email
      - X-authentik-name
      - X-authentik-uid
