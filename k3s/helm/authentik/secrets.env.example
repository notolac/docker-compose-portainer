# Copy to authentik-secrets.env (gitignored, never commit the copy).
# Pass each value via helm --set at install (see README.md).
# Do NOT put real passwords in this example file.

PG_DB=authentik
PG_USER=authentik
PG_PASS=<POSTGRES_PASSWORD>
AUTHENTIK_SECRET_KEY=<AUTHENTIK_SECRET_KEY min 32 chars, e.g. openssl rand -base64 32>
AUTHENTIK_TAG=  # optional pin, e.g. a tag from https://goauthentik.io/releases
AUTHENTIK_HOST=auth.example.com
AUTHENTIK_DATA_PATH=/opt/authentik
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=<bootstrap password if needed, else leave empty>

# Helm install (from the repo root, after copying k3s/helm/authentik/authentik-values.yaml):
# set -a && source authentik-secrets.env && set +a
# helm upgrade --install authentik authentik/authentik -n authentik --create-namespace \
#   -f my-authentik-values.yaml \
#   --set authentik.secret_key="$AUTHENTIK_SECRET_KEY" \
#   --set postgresql.auth.username="$PG_USER" \
#   --set postgresql.auth.password="$PG_PASS"
