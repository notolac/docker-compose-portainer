# Secrets for Vaultwarden on K3s (copy to vaultwarden-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n vaultwarden create secret generic vaultwarden-env --from-env-file=vaultwarden-k3s.env

# SMTP password for SMTP_USERNAME in app.yaml (leave empty if unused).
SMTP_PASSWORD=change-me

# Admin panel token, e.g. output of: openssl rand -base64 48
ADMIN_TOKEN=change-me-generate-with-openssl
