# Secrets for Odoo on K3s (copy to odoo-k3s.env, gitignored — for your records only).
# The manifests consume two Secrets; create them with:
#   kubectl -n odoo create secret generic odoo-db-env --from-literal=POSTGRES_PASSWORD="$ODOO_DB_PASSWORD"
#   kubectl -n odoo create secret generic odoo-config --from-file=odoo.conf=odoo.conf
# (render odoo.conf from odoo.conf.template first, with the same values below)

# Odoo master/database-manager password (odoo.conf [options] admin_passwd).
ODOO_ADMIN_PASSWD=change-me-master-password

# PostgreSQL password for role 'odoo' (odoo.conf db_password + odoo-db-env Secret).
ODOO_DB_PASSWORD=change-me-db-password
