# Secrets for Onyx on K3s (copy to onyx-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n onyx create secret generic onyx-env --from-env-file=onyx-k3s.env

IMAGE_TAG=v4.7.7
POSTGRES_USER=onyxman
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=onyx_db
OPENSEARCH_ADMIN_PASSWORD=change-me-strong-password
USER_AUTH_SECRET=change-me-generate-with-openssl
WEB_DOMAIN=https://onyx.example.com
SMTP_SERVER=mail.example.com
SMTP_PORT=587
SMTP_USER=change-me
SMTP_PASS=change-me
EMAIL_FROM=onyx@example.com
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-password
S3_AWS_ACCESS_KEY_ID=minioadmin
S3_AWS_SECRET_ACCESS_KEY=change-me-minio-password
