# Optional overrides for Linkding on K3s (copy to linkding-k3s.env, gitignored).
# The base Deployment works without a Secret; use these only if you need them.
# Apply with e.g.:
#   kubectl -n linkding set env deploy/linkding LD_CSRF_TRUSTED_ORIGINS="https://links.example.com"

# Must match your public URL(s), comma-separated.
LD_CSRF_TRUSTED_ORIGINS=https://linkding.example.com

# Bootstrap superuser on first start (leave empty to create it in the UI instead).
LD_SUPERUSER_NAME=
LD_SUPERUSER_PASSWORD=
