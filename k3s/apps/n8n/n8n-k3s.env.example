# Secrets for n8n on K3s (copy to n8n-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n n8n create secret generic n8n-env --from-env-file=n8n-k3s.env

# openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me-generate-with-openssl

# openssl rand -base64 24
DB_POSTGRESDB_PASSWORD=change-me-strong-db-password

# Shared secret: n8n broker ↔ sidecar n8nio/runners (external task runners)
# openssl rand -hex 32
N8N_RUNNERS_AUTH_TOKEN=change-me-runners-auth-token
