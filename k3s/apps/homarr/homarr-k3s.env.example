# Secrets for Homarr on K3s (copy to homarr-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n homarr create secret generic homarr-env --from-env-file=homarr-k3s.env

# Random 32+ char string (e.g. openssl rand -hex 32). Changing it later
# invalidates existing sessions/credentials — set once and keep it.
SECRET_ENCRYPTION_KEY=change-me-generate-with-openssl
