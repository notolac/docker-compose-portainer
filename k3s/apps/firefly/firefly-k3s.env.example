# Secrets for Firefly III on K3s (copy to firefly-k3s.env, gitignored).
# The whole file becomes the `firefly-env` Secret:
#   kubectl -n firefly create secret generic firefly-env --from-env-file=firefly-k3s.env
# Explicit env entries in app.yaml take precedence over these values.

# Laravel app key (generate: docker run --rm fireflyiii/core:version-6.7.3 php artisan key:generate --show)
APP_KEY=change-me-base64-key
APP_URL=https://firefly.example.com

# Database (must match POSTGRES_* used by postgres.yaml via the same Secret)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD=change-me-strong-db-password
POSTGRES_DB=firefly
POSTGRES_USER=firefly
POSTGRES_PASSWORD=change-me-strong-db-password

# Mail
MAIL_MAILER=smtp
MAIL_HOST=mail.example.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM=firefly@example.com

# Cron token called by the firefly-cron CronJob (any random string)
STATIC_CRON_TOKEN=change-me-random-string
