# Secrets for Mealie on K3s (copy to mealie-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n mealie create secret generic mealie-env --from-env-file=mealie-k3s.env

# Public URL of your instance (must match your Ingress host).
BASE_URL=https://mealie.example.com

# SMTP (leave empty values if you don't need mail).
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_FROM_NAME=Mealie
SMTP_AUTH_STRATEGY=TLS
SMTP_FROM_EMAIL=mealie@example.com
SMTP_USER=mealie@example.com
SMTP_PASSWORD=change-me

# Optional AI helpers (leave OPENAI_API_KEY empty to disable).
OPENAI_API_KEY=
