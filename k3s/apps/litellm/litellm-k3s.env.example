# Secrets for LiteLLM on K3s (copy to litellm-k3s.env, gitignored).
# Create the Secret with:
#   kubectl -n litellm create secret generic litellm-env --from-env-file=litellm-k3s.env

# Database (used by postgres.yaml and to build DATABASE_URL)
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=change-me-strong-db-password

# SQLAlchemy URL for the proxy, e.g.:
# postgresql://litellm:change-me-strong-db-password@postgres.litellm.svc.cluster.local:5432/litellm
DATABASE_URL=change-me-postgresql-url

# Redis (used by redis.yaml and the proxy ConfigMap)
REDIS_PASSWORD=change-me-strong-redis-password
REDIS_URL=redis://:change-me-strong-redis-password@redis.litellm.svc.cluster.local:6379

# Proxy admin keys (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=change-me-sk-master
LITELLM_SALT_KEY=change-me-salt
